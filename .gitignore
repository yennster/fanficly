# Generated by xcodegen — keep regenerable but committable; comment the line below
# to ignore the project entirely if you'd rather always regenerate locally.
# Fanficly.xcodeproj/

# CocoaPods (unused but defensive)
Pods/
Podfile.lock

# fastlane (the Apple app's, in apple/fastlane/): the lanes and the public
# store copy are tracked so releases run in GitHub Actions
# (.github/workflows/release.yml). Everything generated or secret stays out:
# API keys, built screenshots/previews/creative art, and the App Review contact
# details (filled in from secrets at upload time). A leftover local fastlane/
# at the repo root (from before the apple/ move) holds keys: never track it.
/fastlane/
/apple/fastlane/*
!/apple/fastlane/Fastfile
!/apple/fastlane/Appfile
!/apple/fastlane/Matchfile
!/apple/fastlane/metadata/
!/apple/fastlane/metadata-mac/
/apple/fastlane/metadata*/review_information/first_name.txt
/apple/fastlane/metadata*/review_information/last_name.txt
/apple/fastlane/metadata*/review_information/email_address.txt
/apple/fastlane/metadata*/review_information/phone_number.txt
/apple/fastlane/metadata*/review_information/demo_user.txt
/apple/fastlane/metadata*/review_information/demo_password.txt

# Secrets / signing
*.p8
*.p12
*.mobileprovision

# Python venv for screenshot framing
**/bin/.venv/
__pycache__/

# Local tool scratch dirs
.antigravitycli/
cache/

# Environment
.env
.env.local

# Local agent/session tooling
.entire/
.claude/
.amp/portals/*

# Android machine-local files
android/.gradle/
android/local.properties

# .NET (Windows app)
windows/**/bin/
windows/**/obj/
windows/**/AppPackages/
windows/**/BundleArtifacts/
windows/.vs/
*.user
windows/artifacts/

# Local-only keys and scratch (e.g. the App Store Connect .p8). Never committed.
/.local/
