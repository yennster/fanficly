# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved
!**/xcshareddata/swiftpm/Package.resolved

# Generated by xcodegen — keep regenerable but committable; comment the line below
# to ignore the project entirely if you'd rather always regenerate locally.
# Fanficly.xcodeproj/

# CocoaPods (unused but defensive)
Pods/
Podfile.lock

# fastlane — the lanes and the public store copy are tracked so releases run
# in GitHub Actions (.github/workflows/release.yml). Everything generated or
# secret stays out: API keys, built screenshots/previews/creative art, and the
# App Review contact details (filled in from secrets at upload time).
/fastlane/*
!/fastlane/Fastfile
!/fastlane/Appfile
!/fastlane/Matchfile
!/fastlane/metadata/
!/fastlane/metadata-mac/
/fastlane/metadata*/review_information/first_name.txt
/fastlane/metadata*/review_information/last_name.txt
/fastlane/metadata*/review_information/email_address.txt
/fastlane/metadata*/review_information/phone_number.txt

# Secrets / signing
*.p8
*.p12
*.mobileprovision

# Python venv for screenshot framing
bin/.venv/
__pycache__/

# Local tool scratch dirs
.antigravitycli/
cache/

# Environment
.env
.env.local

# Local agent/session tooling
.entire/
.claude/
.amp/portals/*

# Android machine-local files
android/.gradle/
android/local.properties
