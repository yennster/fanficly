<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI automation tests: launch the built app in demo mode and drive it
       through UI Automation (FlaUI), like FanficlyUITests on Apple platforms.
       Windows only at run time; compiles anywhere. The app under test comes
       from FANFICLY_EXE (CI) or the default unpackaged Debug output. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Fanficly.UITests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
