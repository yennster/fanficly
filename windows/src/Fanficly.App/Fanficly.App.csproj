<Project Sdk="Microsoft.NET.Sdk">
  <!-- The native Windows app: WinUI 3 (Windows App SDK), packaged as MSIX for
       the Microsoft Store and compiled ahead of time (Native AOT) in Release.
       The UI is built in C# rather than XAML markup, so the whole app compiles
       (and is type-checked) on any OS; only packaging needs Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Fanficly.App</RootNamespace>
    <AssemblyName>Fanficly</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Fanficly.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Native AOT needs a runtime per build; MSIX packaging builds once per
         platform, so derive it from the platform when none was passed. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Main lives in Program.cs (single-instance redirection + activation). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Release builds are Native AOT: machine code, no JIT, fast cold start. -->
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <SelfContained Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Trimmed and AOT builds turn HTTP/3 off unless asked (the ILLink targets
         default Http3Support to false), and AO3's edge answers HTTP/2 with 503s,
         525s and 6-36 s waits where HTTP/3 takes under a second. -->
    <Http3Support>true</Http3Support>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <!-- Store packages: one bundle with x64 and ARM64. -->
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <!-- Ships UniversalBGTask.dll at the package root for the timer background task. -->
    <WindowsAppSDKBackgroundTask>true</WindowsAppSDKBackgroundTask>
  </PropertyGroup>

  <!-- Off Windows (Linux/macOS dev machines and agents) the app still
       compiles; MakePri and MSIX packaging only run on Windows. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <!-- HTTP/3 needs msquic.dll beside the exe: .NET loads it from the app's own
       folder, and Windows doesn't ship it. Native AOT drops every native file of
       the runtime pack, msquic.dll included, so the Store build ran with "QUIC
       (HTTP/3) not available" and every request fell back to HTTP/2, where AO3
       answers with 525s and 30 s timeouts. Put it back, and fail the build if
       the runtime pack ever stops carrying it. -->
  <Target Name="KeepMsQuicForHttp3" AfterTargets="ComputeLinkedFilesToPublish" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <_FanficlyMsQuic Include="@(_AssembliesToSkipPublish)" Condition="'%(Filename)%(Extension)' == 'msquic.dll'" />
      <_ResolvedCopyLocalPublishAssets Include="@(_FanficlyMsQuic)" />
    </ItemGroup>
    <Error Condition="'@(_FanficlyMsQuic)' == ''" Text="msquic.dll isn't in the .NET runtime pack for $(RuntimeIdentifier), so this build would have no HTTP/3." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Fanficly.Core\Fanficly.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fanficly.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Public\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
