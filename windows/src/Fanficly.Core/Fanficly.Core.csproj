<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that isn't UI: the AO3 client and HTML parsers, search
       syntax, the library database, sync merging, stats, and the reader's
       pure layout logic. Platform-neutral, so its tests run anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fanficly.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <!-- What's New (#422): the changelog both apps share, at the repo root. -->
    <EmbeddedResource Include="..\..\..\changelog\whats-new.json" LogicalName="Fanficly.Core.whats-new.json" Link="Settings\whats-new.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fanficly.Core.Tests" />
  </ItemGroup>
</Project>
