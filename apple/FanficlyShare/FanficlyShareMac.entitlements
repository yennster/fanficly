<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst (Mac App Store) build only — the Mac App Store
	     requires the App Sandbox on every executable, extensions included.
	     The share extension only forwards the page URL into the app via
	     the fanficly:// scheme, so it needs nothing beyond the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
