    "Delete the app. iOS will erase all on-device storage including the session cookie. There's no server to wipe — there's no server." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete the app. iOS will erase all on-device storage including the session cookie. There's no server to wipe — there's no server."
          }
        }
      }
    },
    "Fanficly has no servers. Everything happens on your phone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
