# Fanficly release lanes. They run in GitHub Actions (.github/workflows/
# release.yml and store-assets.yml) on macOS runners, and on any Mac with
# Xcode. docs/RELEASING.md explains the setup, the secrets and each lane.
#
# Nothing secret lives here. App Store Connect access comes from an API key
# (ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8 in CI, or fastlane/api_key.json
# locally), and certificates/profiles from fastlane match's private repo.
# No lane submits for review: that stays a click in App Store Connect.

require "json"
require "fileutils"

default_platform(:ios)

# fastlane evals this file with a relative name, so __dir__ is "." here, and
# actions run from apple/ while lanes run from apple/fastlane/. Every path is
# absolute so both agree (a relative metadata_path once made deliver upload
# no store text at all).
FASTLANE_DIR = File.expand_path(__dir__)
ROOT = File.dirname(FASTLANE_DIR)
PROJECT = File.join(ROOT, "Fanficly.xcodeproj")
SCHEME = "Fanficly"
API_KEY_JSON = File.join(FASTLANE_DIR, "api_key.json")
SIGNING_XCCONFIG = File.join(ROOT, "Signing.xcconfig")
BUILD_DIR = File.join(ROOT, "build", "release")

# Targets that ship, and their bundle IDs (the Mac app is the same
# universal-purchase app built with Mac Catalyst, so it shares them).
TARGETS = {
  "Fanficly" => "io.github.yennster.fanficly",
  "FanficlyShare" => "io.github.yennster.fanficly.share",
  "FanficlyWidget" => "io.github.yennster.fanficly.widget"
}.freeze

METADATA = { "ios" => File.join(FASTLANE_DIR, "metadata"), "osx" => File.join(FASTLANE_DIR, "metadata-mac") }.freeze
SCREENSHOTS = { "ios" => File.join(FASTLANE_DIR, "screenshots"), "osx" => File.join(FASTLANE_DIR, "screenshots-mac") }.freeze

# Simulators the store art is captured on: the 6.9" iPhone and 13" iPad are
# the required App Store sizes, and the landscape 13" iPad stands in for the
# Mac (there's no Catalyst simulator). See AGENTS.md "Screenshots".
IPHONE_SIM = "iPhone 17 Pro Max"
IPAD_SIM = "iPad Pro 13-inch (M5)"
DUO_SIM = "iPhone Duo"

platform :ios do
  # ---------------------------------------------------------------- signing

  desc "One-time (or after a certificate expires): create the distribution certificates and"
  desc "App Store profiles for iOS and Mac in the match repo. Every other lane only reads them."
  lane :signing_setup do
    asc_api_key
    sync_signing(readonly: false)
  end

  # --------------------------------------------------------------- binaries

  desc "Build and upload to TestFlight. platform: ios, mac or both (default)."
  lane :beta do |options|
    platforms(options).each do |p|
      path = build_signed(platform: p)
      upload_to_testflight(**binary_option(p, path), app_platform: p, changelog: release_notes,
                           # Waiting lets pilot set the changelog ("What to Test") once processed.
                           skip_waiting_for_build_processing: false, wait_processing_timeout_duration: 3600)
    end
  end

  desc "Build, upload, and push metadata + screenshots to the App Store version."
  desc "Does not submit for review. platform: ios, mac or both (default)."
  lane :release do |options|
    platforms(options).each do |p|
      path = build_signed(platform: p)
      deliver_version(p, binary: path)
    end
  end

  desc "Push only metadata + screenshots (no binary). platform: ios, mac or both (default)."
  lane :metadata_only do |options|
    asc_api_key
    platforms(options).each { |p| deliver_version(p) }
  end

  desc "Download the live store copy into fastlane/metadata (iOS) and"
  desc "fastlane/metadata-mac (Mac), minus the App Review contact details."
  lane :pull_metadata do
    asc_api_key
    write_key_files
    %w[ios osx].each do |p|
      sh("bundle", "exec", "fastlane", "deliver", "download_metadata",
         "--api_key_path", API_KEY_JSON,
         "--app_identifier", TARGETS["Fanficly"],
         "--platform", p,
         "--metadata_path", METADATA[p],
         "--force")
      Dir.glob(File.join(METADATA[p], "review_information", "{first_name,last_name,email_address,phone_number,demo_user,demo_password}.txt"))
         .each { |f| File.delete(f) }
    end
  end

  # -------------------------------------------------------------- store art

  desc "Regenerate everything the store listing shows: screenshots (iPhone, iPad, Mac,"
  desc "iPhone Duo), app previews and the creative assets. Uploads nothing."
  lane :store_art do
    screenshots
    previews
    creative_assets
  end

  desc "Capture demo-mode screenshots on the simulators and frame them into App Store images."
  lane :screenshots do
    iphone = simulator(IPHONE_SIM)
    ipad = simulator(IPAD_SIM)
    UI.user_error!("Need the #{IPHONE_SIM} and #{IPAD_SIM} simulators") unless iphone && ipad
    capture(iphone, "testCaptureMainScreens")
    capture(ipad, "testCaptureMainScreens")
    capture(ipad, "testCaptureMacScreens")
    # The Duo simulator ships with Xcode 27.1. Its pose (folded/unfolded) can
    # only be set by hand in Device Hub, so CI captures whichever display it
    # boots on and keeps the committed captures for the other.
    if (duo = simulator(DUO_SIM))
      capture(duo, "testCaptureDuoScreens")
    else
      UI.important("No #{DUO_SIM} simulator in this Xcode: reframing the committed Duo captures")
    end
    [iphone, ipad, duo].compact.each { |udid| sh(File.join(ROOT, "bin/sim-marketing-mode.sh"), "off", udid) }
    sh(python, File.join(ROOT, "bin/frame-screenshots.py"))
  end

  desc "Record the app-preview videos (iPhone, iPad, Mac) and write a contact sheet of each."
  lane :previews do
    iphone = simulator(IPHONE_SIM)
    ipad = simulator(IPAD_SIM)
    UI.user_error!("Need the #{IPHONE_SIM} and #{IPAD_SIM} simulators") unless iphone && ipad
    # The same simulators the screenshots used, not the script's own pick.
    ENV["IPHONE_UDID"] = iphone
    ENV["IPAD_UDID"] = ipad
    sh(File.join(ROOT, "bin/record-app-previews.sh"))
    # Caption timings are tuned to the recordings; a contact sheet per video
    # makes drift easy to spot before uploading.
    sheets = File.join(ROOT, "build", "preview-contact-sheets")
    FileUtils.mkdir_p(sheets)
    Dir.glob(File.join(FASTLANE_DIR, "previews", "en-US", "*.mp4")).each do |mp4|
      sh("ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-i", mp4,
         "-vf", "fps=1,scale=240:-2,tile=6x5", "-frames:v", "1",
         File.join(sheets, "#{File.basename(mp4, '.mp4')}.png"))
    end
  end

  desc "Render the product-page header and search-results creative assets."
  lane :creative_assets do
    sh(python, File.join(ROOT, "bin/make-creative-assets.py"))
  end

  desc "Upload the generated store art to the editable App Store versions: screenshots"
  desc "(iOS + Mac), app previews, iPhone Duo screenshots and the creative assets."
  lane :upload_store_art do
    asc_api_key
    write_key_files
    %w[ios osx].each do |p|
      next unless Dir.exist?(SCREENSHOTS[p])
      deliver(
        platform: p,
        app_version: marketing_version,
        skip_binary_upload: true,
        skip_metadata: true,
        screenshots_path: SCREENSHOTS[p],
        overwrite_screenshots: true,
        submit_for_review: false,
        force: true,
        run_precheck_before_submit: false
      )
    end
    sh(python, File.join(ROOT, "bin/upload-app-previews.py"), "--replace") if Dir.exist?(File.join(FASTLANE_DIR, "previews", "en-US"))
    sh(python, File.join(ROOT, "bin/upload-duo-assets.py")) if Dir.exist?(File.join(FASTLANE_DIR, "screenshots-duo", "en-US"))
    sh(python, File.join(ROOT, "bin/upload-creative-assets.py"), "--replace") if Dir.exist?(File.join(FASTLANE_DIR, "creative", "en-US"))
  end

  # ------------------------------------------------------------------ tests

  desc "Unit tests on an iPhone and an iPad simulator, then under Mac Catalyst."
  lane :unit_tests do
    [simulator(IPHONE_SIM), simulator(IPAD_SIM)].compact.each do |udid|
      xcodebuild_test("id=#{udid}", "FanficlyTests")
    end
    xcodebuild_test("platform=macOS,variant=Mac Catalyst", "FanficlyTests", "MACOSX_DEPLOYMENT_TARGET=14.0")
  end

  desc "Reader layout UI tests on the iPhone, iPad and iPhone Duo simulators, then the Mac"
  desc "(see AGENTS.md). Options: devices:\"iPhone Duo\" (comma-separated), mac:false."
  lane :reader_layout_tests do |options|
    names = (options[:devices] || [IPHONE_SIM, IPAD_SIM, DUO_SIM].join(",")).split(",").map(&:strip)
    names.map { |name| simulator(name) }.compact.each do |udid|
      xcodebuild_test("id=#{udid}", "FanficlyUITests/ReaderLayoutTests")
    end
    # The Mac run drives the real app window, so it never runs in CI.
    unless options[:mac].to_s == "false" || ENV["CI"]
      xcodebuild_test("platform=macOS,variant=Mac Catalyst", "FanficlyUITests/ReaderLayoutTests",
                      "MACOSX_DEPLOYMENT_TARGET=14.0")
    end
  end

  # ---------------------------------------------------------------- helpers

  # App Store Connect API key: env vars in CI, fastlane/api_key.json locally.
  private_lane :asc_api_key do
    if ENV["ASC_KEY_ID"].to_s.empty?
      UI.user_error!("No App Store Connect API key: set ASC_KEY_ID/ASC_ISSUER_ID/ASC_KEY_P8 or create #{API_KEY_JSON}") unless File.exist?(API_KEY_JSON)
      key = JSON.parse(File.read(API_KEY_JSON))
      app_store_connect_api_key(key_id: key["key_id"], issuer_id: key["issuer_id"], key_content: key["key"])
    else
      app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"])
    end
  end

  # Installs the certificates and profiles from match, then points the
  # project's Signing.xcconfig at them (manual signing, per target and per
  # SDK, so the Catalyst build gets its Mac profiles).
  private_lane :sync_signing do |options|
    readonly = options.fetch(:readonly, true)
    team = ENV["APPLE_TEAM_ID"].to_s
    UI.user_error!("Set APPLE_TEAM_ID") if team.empty?
    setup_ci if ENV["CI"]
    ids = TARGETS.values
    match(app_identifier: ids, platform: "ios", readonly: readonly, team_id: team)
    ios = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].dup
    match(app_identifier: ids, platform: "catalyst", readonly: readonly, team_id: team,
          additional_cert_types: ["mac_installer_distribution"])
    mac = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].dup

    lines = [
      "// Written by fastlane (sync_signing) for a release build. Not committed.",
      "DEVELOPMENT_TEAM = #{team}",
      "CODE_SIGN_STYLE = Manual",
      "CODE_SIGN_IDENTITY = Apple Distribution",
      "PROVISIONING_PROFILE_SPECIFIER = $(FANFICLY_IOS_PROFILE_$(TARGET_NAME))",
      "PROVISIONING_PROFILE_SPECIFIER[sdk=macosx*] = $(FANFICLY_MAC_PROFILE_$(TARGET_NAME))"
    ]
    TARGETS.each do |target, id|
      lines << "FANFICLY_IOS_PROFILE_#{target} = #{ios.fetch(id)}"
      lines << "FANFICLY_MAC_PROFILE_#{target} = #{mac.fetch(id)}"
    end
    File.write(SIGNING_XCCONFIG, lines.join("\n") + "\n")
    { "ios" => ios, "osx" => mac }
  end

  # Builds a signed .ipa (ios) or Mac App Store .pkg (osx) with the next free
  # build number, and returns its path. Signing.xcconfig is restored afterwards.
  private_lane :build_signed do |options|
    p = options[:platform]
    asc_api_key
    original = File.read(SIGNING_XCCONFIG)
    begin
      profiles = sync_signing(readonly: true)
      # Both platforms of one run share a build number, as they always have.
      build = (@build_number ||= next_build_number)
      UI.message("Building #{p} #{marketing_version} (#{build})")
      FileUtils.mkdir_p(BUILD_DIR)
      File.write(File.join(BUILD_DIR, "build-number.txt"), build.to_s)
      common = {
        project: PROJECT,
        scheme: SCHEME,
        configuration: "Release",
        output_directory: BUILD_DIR,
        output_name: "Fanficly-#{p}",
        clean: true,
        # On the command line because XcodeGen's iOS preset puts
        # CODE_SIGN_IDENTITY = "iPhone Developer" on the app target itself,
        # which beats the Signing.xcconfig written above.
        xcargs: "CURRENT_PROJECT_VERSION=#{build} CODE_SIGN_IDENTITY='Apple Distribution'"
      }
      if p == "ios"
        build_app(**common,
                  destination: "generic/platform=iOS",
                  export_method: "app-store",
                  export_options: { signingStyle: "manual", provisioningProfiles: profiles["ios"] })
        lane_context[SharedValues::IPA_OUTPUT_PATH]
      else
        build_app(**common,
                  catalyst_platform: "macos",
                  destination: "generic/platform=macOS,variant=Mac Catalyst",
                  export_method: "app-store",
                  installer_cert_name: installer_identity,
                  export_options: { signingStyle: "manual", provisioningProfiles: profiles["osx"] })
        lane_context[SharedValues::PKG_OUTPUT_PATH]
      end
    ensure
      File.write(SIGNING_XCCONFIG, original)
    end
  end

  def platforms(options)
    case (options[:platform] || "both").to_s
    when "ios" then ["ios"]
    when "mac", "osx", "macos" then ["osx"]
    when "both" then %w[ios osx]
    else UI.user_error!("platform must be ios, mac or both")
    end
  end

  def deliver_version(p, binary: nil)
    UI.user_error!("Missing #{METADATA[p]}: run the pull_metadata lane first") unless Dir.exist?(METADATA[p])
    if (notes = release_notes)
      FileUtils.mkdir_p(File.join(METADATA[p], "en-US"))
      File.write(File.join(METADATA[p], "en-US", "release_notes.txt"), notes)
    end
    write_key_files
    deliver(
      **binary_option(p, binary),
      platform: p,
      app_version: marketing_version,
      skip_binary_upload: binary.nil?,
      metadata_path: METADATA[p],
      screenshots_path: SCREENSHOTS[p],
      skip_screenshots: !Dir.exist?(SCREENSHOTS[p]),
      overwrite_screenshots: true,
      app_review_information: review_information,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
    verify_store_text(p)
  end

  # deliver skips text it can't find without a word, so check that the
  # editable version really has its What's New and Promotional Text.
  def verify_store_text(p)
    app = Spaceship::ConnectAPI::App.find(TARGETS["Fanficly"])
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform.map(p))
    UI.user_error!("No editable #{p} version on App Store Connect") unless version
    loc = version.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    missing = { "What's New" => loc&.whats_new, "Promotional Text" => loc&.promotional_text }
              .select { |_, v| v.to_s.strip.empty? }.keys
    UI.user_error!("#{p} #{version.version_string} en-US has no #{missing.join(' or ')} on App Store Connect") unless missing.empty?
    UI.success("#{p} #{version.version_string}: What's New and Promotional Text are set")
  end

  # The ipa:/pkg: option for an upload. pilot and deliver default ipa: to the
  # last build's .ipa, so a Mac upload after an iOS build forgets it first.
  def binary_option(p, path)
    lane_context.delete(SharedValues::IPA_OUTPUT_PATH) if p == "osx"
    return {} unless path
    p == "ios" ? { ipa: path } : { pkg: path }
  end

  # The App Store "What's New" and TestFlight text the release workflow
  # collected (bin/release-notes.py), or nil to keep what's in metadata/.
  def release_notes
    file = ENV["RELEASE_NOTES_FILE"].to_s
    file.empty? || !File.exist?(file) ? nil : File.read(file).strip
  end

  # App Review contact details come from secrets, never from the repo.
  def review_information
    info = {
      first_name: ENV["REVIEW_FIRST_NAME"],
      last_name: ENV["REVIEW_LAST_NAME"],
      email_address: ENV["REVIEW_EMAIL"],
      phone_number: ENV["REVIEW_PHONE"],
      demo_user: ENV["REVIEW_DEMO_USER"],
      demo_password: ENV["REVIEW_DEMO_PASSWORD"]
    }.reject { |_, v| v.to_s.empty? }
    info.empty? ? nil : info
  end

  def marketing_version
    File.read(File.join(ROOT, "project.yml"))[/MARKETING_VERSION:\s*"([^"]+)"/, 1]
  end

  # One build-number sequence for both platforms: one past the highest of
  # TestFlight's iOS and Mac builds and project.yml's. Nothing is committed.
  def next_build_number
    floor = File.read(File.join(ROOT, "project.yml"))[/CURRENT_PROJECT_VERSION:\s*"(\d+)"/, 1].to_i
    seen = %w[ios osx].map do |p|
      latest_testflight_build_number(app_identifier: TARGETS["Fanficly"], platform: p, initial_build_number: 0).to_i
    rescue StandardError => e
      UI.important("No TestFlight build number for #{p}: #{e.message}")
      0
    end
    ([floor] + seen).max + 1
  end

  def installer_identity
    out = sh("security", "find-identity", "-v", log: false)
    out[/"(3rd Party Mac Developer Installer[^"]*|Mac Installer Distribution[^"]*)"/, 1] ||
      UI.user_error!("No Mac installer certificate in the keychain (run signing_setup)")
  end

  # The bin/ uploaders read fastlane/api_key.json + the .p8; write them from
  # the CI secrets when they aren't there (both paths are git-ignored).
  def write_key_files
    return if ENV["ASC_KEY_ID"].to_s.empty?
    File.write(API_KEY_JSON, JSON.pretty_generate(
      "key_id" => ENV["ASC_KEY_ID"], "issuer_id" => ENV["ASC_ISSUER_ID"],
      "key" => ENV["ASC_KEY_P8"], "in_house" => false
    ))
    File.write(File.join(FASTLANE_DIR, "AuthKey_#{ENV['ASC_KEY_ID']}.p8"), ENV["ASC_KEY_P8"])
  end

  def python
    venv = File.join(ROOT, "bin/.venv/bin/python")
    File.exist?(venv) ? venv : "python3"
  end

  # The UDID of an available simulator with exactly this name on the newest
  # iOS runtime, creating one when the device type exists but no device does.
  # nil when this Xcode doesn't have the device at all.
  def simulator(name)
    version = ->(runtime) { runtime.scan(/\d+/).map(&:to_i) }
    devices = JSON.parse(sh("xcrun", "simctl", "list", "devices", "available", "--json", log: false))["devices"]
    found = devices.select { |rt, _| rt.include?("iOS") }
                   .sort_by { |rt, _| version.call(rt) }.reverse
                   .flat_map { |_, list| list }
                   .find { |d| d["name"] == name }
    return found["udid"] if found

    type = JSON.parse(sh("xcrun", "simctl", "list", "devicetypes", "--json", log: false))["devicetypes"]
               .find { |t| t["name"] == name }
    runtime = JSON.parse(sh("xcrun", "simctl", "list", "runtimes", "available", "--json", log: false))["runtimes"]
                  .select { |r| r["name"].to_s.start_with?("iOS") }
                  .max_by { |r| version.call(r["version"]) }
    return nil unless type && runtime
    sh("xcrun", "simctl", "create", name, type["identifier"], runtime["identifier"], log: false).strip
  end

  def capture(udid, test)
    sh(File.join(ROOT, "bin/sim-marketing-mode.sh"), "on", udid)
    xcodebuild_test("id=#{udid}", "FanficlyUITests/ScreenshotTests/#{test}")
  end

  def xcodebuild_test(destination, only, *extra)
    sh("xcodebuild", "test",
       "-project", PROJECT, "-scheme", SCHEME,
       "-destination", destination,
       "-derivedDataPath", File.join(ROOT, "build"),
       "-only-testing:#{only}",
       "CODE_SIGNING_ALLOWED=NO", *extra)
  end
end
