# Fanficly — fastlane app configuration.
# Values are read from the environment so no personal IDs are committed.
# Set these in your shell or a local (git-ignored) fastlane/.env file:
#   FASTLANE_APPLE_ID   – your Apple ID email (App Store Connect login)
#   ASC_TEAM_ID         – App Store Connect team id (numeric)  [optional]
#   DEVELOPER_TEAM_ID   – Apple Developer Program team id (10-char)  [optional]
# When using an App Store Connect API key (recommended), team ids are optional.

app_identifier("io.github.yennster.fanficly")
apple_id(ENV["FASTLANE_APPLE_ID"])
itc_team_id(ENV["ASC_TEAM_ID"]) if ENV["ASC_TEAM_ID"]
team_id(ENV["DEVELOPER_TEAM_ID"]) if ENV["DEVELOPER_TEAM_ID"]
