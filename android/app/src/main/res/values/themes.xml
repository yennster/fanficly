<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The Compose UI supplies the real Material 3
         color scheme at runtime (FanficlyTheme); this is just the launch /
         system-chrome theme so there's no white flash before Compose mounts. -->
    <style name="Theme.Fanficly" parent="android:Theme.Material.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/ao3_maroon</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
